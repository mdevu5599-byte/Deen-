rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Roles are Firebase custom claims set ONLY by the setUserRole Cloud Function.
    function role() { return request.auth.token.get('role', 'user'); }
    function isAdmin() { return signedIn() && (role() == 'admin' || role() == 'super_admin'); }
    function isSuperAdmin() { return signedIn() && role() == 'super_admin'; }
    function ownsDoc() { return signedIn() && resource.data.uid == request.auth.uid; }
    function createsOwnDoc() { return signedIn() && request.resource.data.uid == request.auth.uid; }
    function noRoleFields() {
      return !request.resource.data.keys().hasAny(['role', 'roles', 'isAdmin', 'claims']);
    }

    // ---------- user-owned data ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && noRoleFields()
        && request.resource.data.uid == uid
        && request.resource.data.accountType in ['personal', 'public']
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80;
      allow update: if (isOwner(uid) && noRoleFields()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.accountType == resource.data.accountType
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80)
        || isSuperAdmin();
      allow delete: if false;   // deletion happens in the deleteMyAccount function
    }

    // Keep read rules independent of request.resource (which only exists on writes).
    match /user_settings/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && noRoleFields();
      allow delete: if isOwner(uid);
    }
    match /notification_preferences/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && noRoleFields();
      allow delete: if isOwner(uid);
    }
    match /prayer_settings/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && noRoleFields();
      allow delete: if isOwner(uid);
    }

    // Documents keyed "<uid>_<yyyy-mm-dd>" carrying a uid field.
    match /prayer_records/{id} {
      allow read: if ownsDoc();
      allow create, update: if createsOwnDoc() && id.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow delete: if ownsDoc();
    }
    match /ibadah_records/{id} {
      allow read: if ownsDoc();
      allow create, update: if createsOwnDoc() && id.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow delete: if ownsDoc();
    }
    match /tasbih_records/{id} {
      allow read: if ownsDoc();
      allow create, update: if createsOwnDoc() && id.matches('^' + request.auth.uid + '_.*');
      allow delete: if ownsDoc();
    }
    // Private journal: owner only. Admins and super admins have NO access.
    match /journals/{id} {
      allow read: if ownsDoc();
      allow create, update: if createsOwnDoc()
        && id.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['uid', 'date', 'answers', 'clientUpdatedAt', 'updatedAt'])
        && request.resource.data.answers.size() <= 20;
      allow delete: if ownsDoc();
    }

    // ---------- published content (read-only for clients) ----------
    // Writes go through validating Cloud Functions (saveContent / setContentStatus).
    match /hadith/{id} {
      allow read: if resource.data.status == 'verified' || isAdmin();
      allow write: if false;
    }
    match /reminders/{id} {
      allow read: if resource.data.status == 'verified' || isAdmin();
      allow write: if false;
    }
    match /duas/{id} {
      allow read: if resource.data.status == 'verified' || isAdmin();
      allow write: if false;
    }
    match /quran_verses/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /hadith_categories/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /app_settings/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- administration ----------
    match /admin_users/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Account suspension metadata is visible to admins; only trusted Functions write it.
    match /user_admin_status/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /notification_jobs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /notification_logs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow write: if false;   // append-only from Cloud Functions
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
